# Serene — environment configuration (copy to .env)

# Amelia — the external AI sales platform. The site's single conversion target.
VITE_AMELIA_URL=https://amelia.serene.com

# Google Analytics 4. Leave empty to disable analytics entirely.
# Loads only after cookie consent regardless of this value.
VITE_GA_ID=

# Contact form endpoint (Formspree / serverless function URL).
# Without it the form completes locally so the flow can be exercised in dev.
VITE_CONTACT_ENDPOINT=
