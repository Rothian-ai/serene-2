# Serene — environment configuration (copy to .env)

# Amelia — the external AI sales platform. The site's single conversion target.
VITE_AMELIA_URL=https://amelia.serene.com

# Google Analytics 4. Leave empty to disable analytics entirely.
# Loads only after cookie consent regardless of this value.
VITE_GA_ID=

# Contact form endpoint. Defaults to the built-in /api/submit route (Prisma + SMTP);
# only set this to override with an external endpoint (e.g. Formspree).
VITE_CONTACT_ENDPOINT=

# ── Backend (Vercel / SSR) ─────────────────────────────────────────
# Neon Postgres (Project → Connection Details):
#   DATABASE_URL = POOLED connection (…-pooler…) — app runtime
#   DIRECT_URL   = DIRECT connection — `prisma migrate` / `prisma db push`
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/serene?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/serene?sslmode=require"

# Admin dashboard (/dashboard) — password + signed cookie session
ADMIN_PASSWORD="change-me-to-something-strong"
SESSION_SECRET="generate-a-long-random-string"

# SMTP — notification email on each new submission
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT="587"
SMTP_SECURE="false"          # "true" for port 465, "false" for 587/STARTTLS
SMTP_USER="postmaster@serene.com"
SMTP_PASS="your-smtp-password"
MAIL_FROM="Serene <noreply@serene.com>"
MAIL_TO="enquiries@serene.com"
