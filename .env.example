# Serene — environment configuration. Copy to `.env` for local dev.
# `.env` is gitignored; never commit real credentials.
# On Vercel these go in Project → Settings → Environment Variables.

# ── Contact form: SMTP (REQUIRED for the form to work) ─────────────
# The form posts to /api/submit, which emails the house over SMTP.
# Verify these before deploying:  npm run smtp:check -- you@example.com
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT="587"                        # 587 = STARTTLS, 465 = implicit TLS
SMTP_SECURE="false"                    # "true" ONLY for port 465
SMTP_USER="postmaster@serene.com"
SMTP_PASS=""                           # password or app-specific key
# MAIL_FROM must be a sender your provider has authorised, or sends are rejected.
MAIL_FROM="Serene <noreply@serene.com>"
# Where enquiries land. Comma-separate for several recipients.
MAIL_TO="enquiries@serene.com"
# "true" sends the enquirer one courtesy acknowledgement. Off by default —
# the site promises no follow-up sequences, so this stays a deliberate choice.
MAIL_ACK="false"

# ── Submissions database (OPTIONAL) ────────────────────────────────
# Leave DATABASE_URL empty and the form still works on SMTP alone; the
# /dashboard submissions list is simply empty. Set both to enable storage.
# Neon → Project → Connection Details:
#   DATABASE_URL = POOLED connection (…-pooler…) — app runtime
#   DIRECT_URL   = DIRECT connection — `prisma db push` / `migrate`
DATABASE_URL=""
DIRECT_URL=""

# ── Admin dashboard at /dashboard (only needed if using the database) ──
ADMIN_PASSWORD=""
SESSION_SECRET=""                      # a long random string

# ── Front end ──────────────────────────────────────────────────────
# Google Analytics 4. Empty disables it. Loads only after cookie consent.
VITE_GA_ID=""

# Override the form's destination only if replacing /api/submit with an
# external service (e.g. Formspree). Leave empty to use the built-in route.
VITE_CONTACT_ENDPOINT=""

# ── Amelia Partner Listing API (powers /properties) ────────────────
# Server-only: no VITE_ prefix, ever. The API sends no CORS headers by
# design, so it is called from loaders and never from the browser.
# Leave AMELIA_API_KEY empty and /properties shows an explained empty state.
AMELIA_API_BASE="https://amelia.serenebay.ae"
AMELIA_API_KEY=""                      # amk_… issued per organisation
# Public org id, used by the register-interest form (POST /api/leads/capture).
AMELIA_ORG_KEY=""
# Public white-label domain used for buyer-signup deep links (safe client-side).
VITE_AMELIA_PUBLIC_BASE="https://amelia.serenebay.ae"

# Amelia's WhatsApp Business number, digits only or with punctuation (it is
# stripped). Set it and every "Request a conversation" CTA opens a WhatsApp
# thread instead of the contact form. Leave it empty and the form stays, which
# is what writes to the database and sends the SMTP notification.
VITE_AMELIA_WHATSAPP=""
